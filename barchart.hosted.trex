<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <!-- Bản HOSTED (HTTPS) cho Tableau Cloud/Server hoặc workshop từ xa.
       KHÁC bản localhost DUY NHẤT ở <url>. Giữ NGUYÊN id để không mất settings.
       Thay YOUR-USER/YOUR-REPO bằng GitHub Pages thật (hoặc Netlify URL). -->
  <worksheet-extension id="com.sonnguyen.vizplatform.barchart" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Bar chart mẫu — nền tảng viz extension (BUILD ZONE).</description>
    <author name="son.nguyen" email="son.nguyen@corp.local" organization="Tableau Viz Platform" website="https://viz.corp.local"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://sonnguyendataai.github.io/tableau-viz-extensions/src/vizzes/barchart/barchart.html</url>
    </source-location>
    <icon/>

    <encoding id="category">
      <display-name>Category</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-x"/>
    </encoding>

    <encoding id="value">
      <display-name>Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="bar"/>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Bar Chart (Platform Sample)</text>
    </resource>
  </resources>
</manifest>
