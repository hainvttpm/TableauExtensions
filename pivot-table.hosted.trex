<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <!-- Bản HOSTED (HTTPS) cho Tableau Cloud/Server hoặc workshop từ xa.
       KHÁC bản localhost DUY NHẤT ở <url>. Giữ NGUYÊN id để không mất settings.
       Thay YOUR-USER/YOUR-REPO bằng GitHub Pages thật (hoặc Netlify URL). -->
  <worksheet-extension id="com.sonnguyen.vizplatform.pivottable" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Bảng ma trận (pivot/crosstab) header nhóm nhiều tầng — mẫu báo cáo KQKD (BUILD ZONE).</description>
    <author name="son.nguyen" email="son.nguyen@corp.local" organization="Tableau Viz Platform" website="https://viz.corp.local"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://sonnguyendataai.github.io/tableau-viz-extensions/src/vizzes/pivot-table/pivot-table.html</url>
    </source-location>
    <icon/>

    <encoding id="rows">
      <display-name>Rows (nhãn hàng)</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="5"/>
      <encoding-icon token="letter-y"/>
    </encoding>

    <encoding id="cols">
      <display-name>Columns (nhóm cột)</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="5"/>
      <encoding-icon token="letter-x"/>
    </encoding>

    <encoding id="values">
      <display-name>Values (giá trị ô)</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="10"/>
      <encoding-icon token="text"/>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Pivot Table / Matrix (Platform Sample)</text>
    </resource>
  </resources>
</manifest>
