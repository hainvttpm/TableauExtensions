<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <!-- Bản HOSTED cho Tableau Server on-prem. KHÁC bản localhost DUY NHẤT ở <url>.
       Giữ NGUYÊN id để workbook đã publish không mất settings.

       On-prem, air-gapped:
         - Trỏ <url> tới web server TĨNH NỘI BỘ (IIS/nginx/Apache), reachable với
           trình duyệt của MỌI viewer — KHÔNG dùng localhost (đó là máy viewer).
         - Server chạy HTTPS → URL này cũng phải HTTPS + cert được trình duyệt
           viewer tin (CA nội bộ). Self-signed lạ sẽ bị chặn im lặng.
         - Copy lib/ + src/core/ + src/vizzes/radar/ lên web root, GIỮ NGUYÊN cấu
           trúc path. radar.js là ES module import ../../core/*.js; .html nạp
           ../../../lib/*.js — thiếu src/core/ sẽ vỡ khi load (bare-import / 404).
         - Web server PHẢI trả .js với MIME application/javascript.
         - Admin: Server → Settings → Extensions → bật + allow-list domain này.
       Thay viz.corp.local bằng hostname nội bộ thật. -->
  <worksheet-extension id="com.sonnguyen.vizplatform.radar" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Radar / spider chart — nhiều series, trục = category (BUILD ZONE).</description>
    <author name="son.nguyen" email="son.nguyen@corp.local" organization="Tableau Viz Platform" website="https://viz.corp.local"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://sonnguyendataai.github.io/tableau-viz-extensions/src/vizzes/radar/radar.html</url>
    </source-location>
    <icon/>

    <encoding id="category">
      <display-name>Category (axes)</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-x"/>
    </encoding>

    <encoding id="measures">
      <display-name>Measures (series)</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="6"/>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Radar Chart (Spider)</text>
    </resource>
  </resources>
</manifest>
